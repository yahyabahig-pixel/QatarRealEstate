# Copy this file to .env.local (git-ignored by Vite convention) to leave mock mode.
#
#   No VITE_API_URL  → MOCK MODE: the site runs entirely on the seed data in
#                      src/data/mockData.js. No backend needed.
#   VITE_API_URL set → LIVE MODE: every page reads from the ASP.NET Core API and the
#                      admin panel writes to it.
#
# 5222 is the Host's http profile (src/Host/Properties/launchSettings.json). Running
# `dotnet run --project src/Host` uses that profile, and with no https port bound the
# https-redirect middleware stays quiet. The backend's CORS allowlist already permits
# http://localhost:5173 (Vite's default); serve the frontend elsewhere and you must add
# that origin to Cors:AllowedOrigins in appsettings.json.

VITE_API_URL=http://localhost:5222
