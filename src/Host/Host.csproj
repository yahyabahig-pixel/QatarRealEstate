<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.2" />

    <!-- Pinned to close GHSA-v5pm-xwqc-g5wc, a HIGH severity advisory.
         Microsoft.AspNetCore.OpenApi 10.0.2 pulls Microsoft.OpenApi 2.0.0 transitively, and
         every 2.x before 2.7.5 overflows the stack on an OpenAPI document containing a
         circular schema reference — uncontrolled recursion, and the process dies. `dotnet
         restore` has been printing NU1903 about it on every build.
         An explicit reference wins over a transitive one, so this is what lifts the whole
         graph onto the patched version. Remove this line only once the AspNetCore package
         itself depends on 2.7.5 or later — and check `dotnet restore` stays quiet when you do. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />

    <!-- Composition root: the ONLY project that references both ends of each module. -->
    <!-- Explicit rather than transitive: Program.cs registers the shared pipeline behaviour
         from this assembly by name, so the dependency is real and should be stated. -->
    <ProjectReference Include="..\BuildingBlocks\BuildingBlocks.Application\BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\Modules\RealEstate\RealEstate.Api\RealEstate.Api.csproj" />
    <ProjectReference Include="..\Modules\RealEstate\RealEstate.Infrastructure\RealEstate.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Auth\Auth.Api\Auth.Api.csproj" />
    <ProjectReference Include="..\Modules\Auth\Auth.Infrastructure\Auth.Infrastructure.csproj" />
  </ItemGroup>

</Project>
