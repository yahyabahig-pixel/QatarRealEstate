# ---------------------------------------------------------------------------
# Caddy — the TLS edge. The only container published to the internet.
# Chain: internet -> caddy:443 -> frontend:80 (nginx) -> backend:8080 (Kestrel)
#
# Two modes, both driven from .env — no edits to this file are needed:
#
#   SELF-SIGNED (default, works on a bare IP, browsers WILL warn)
#     SITE_ADDRESS=:443
#     CADDY_TLS=internal
#
#   REAL CERTIFICATE (needs a hostname pointing at this server)
#     SITE_ADDRESS=qre.example.com
#     CADDY_TLS=you@example.com
#     CADDY_HSTS=max-age=300            <- then raise it once the site is confirmed
#
# After switching to a hostname, PUBLIC_ORIGIN in .env must become
# https://qre.example.com AND the frontend image must be rebuilt — Vite bakes it
# into the JS bundle at build time, so a restart is not enough:
#     docker compose build frontend && docker compose up -d
# ---------------------------------------------------------------------------
{
	# Rehearse certificate issuance against Let's Encrypt's staging CA before
	# going live: it hands out untrusted certs but has far looser rate limits.
	# Production allows ~5 failed validations per hostname per hour.
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

{$SITE_ADDRESS} {
	# `internal` = Caddy's own local CA (self-signed).
	# An email address = Let's Encrypt, used as the ACME account contact.
	tls {$CADDY_TLS}

	encode zstd gzip

	header {
		# Caddy's own banner adds nothing but a version number for scanners.
		-Server

		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"

		# HSTS. Driven from .env so it can be turned on WITHOUT editing this file,
		# which is what kept it commented out and forgotten.
		#
		#   CADDY_HSTS="max-age=0"                             <- off (the default)
		#   CADDY_HSTS="max-age=300"                           <- 5-minute rehearsal
		#   CADDY_HSTS="max-age=31536000; includeSubDomains"   <- live
		#
		# The default is max-age=0 rather than no header at all, because that is the
		# documented way to CLEAR an HSTS policy a browser has already cached. If
		# HSTS is ever turned on by mistake, setting this back to max-age=0 is what
		# releases the visitors who saw it.
		#
		# Turn it on ONLY once a real, trusted certificate is being served. HSTS
		# pins this host to HTTPS in every visitor's browser for as long as
		# max-age says, and a browser that has seen it will refuse to fall back —
		# so switching it on while still using Caddy's internal CA locks people
		# out of the site, and lowering max-age afterwards does not reach the
		# browsers that already cached it. Start at max-age=300, confirm the site
		# still loads in a fresh browser, then raise it.
		Strict-Transport-Security {$CADDY_HSTS}
	}

	# Content-Security-Policy is set by nginx, one layer in — see
	# docker/nginx/security-headers.conf. It lives there because that is the layer
	# that also serves the files the policy is about, and because the site works
	# with or without Caddy in front of it.
	#
	# (It used to say there was deliberately no CSP at all, on the grounds that the
	# app loaded scripts from a third-party CDN. It no longer does: MapLibre is
	# bundled and served from this origin, which is what made a real policy
	# possible.)

	reverse_proxy frontend:80 {
		# Property photo uploads are ~25 MB and the API resizes them inline, so
		# the default 30s round-trip ceiling is too tight.
		transport http {
			dial_timeout 30s
			response_header_timeout 120s
			read_timeout 120s
			write_timeout 120s
		}

		# Caddy already sets X-Forwarded-For / -Proto / -Host. nginx maps
		# X-Forwarded-Proto through to Kestrel — see docker/nginx/default.conf.
	}
}
