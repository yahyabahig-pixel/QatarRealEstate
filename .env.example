# =========================================================================================
# Template for the server-side .env file that docker-compose.yml reads.
#
# The REAL .env lives only at /opt/qre/.env on the VPS. It is git-ignored and must never be
# committed - every value below is a secret except PUBLIC_ORIGIN, SITE_ADDRESS and CADDY_TLS.
#
# If any of these values were ever committed, pushed to a public repository, pasted into a
# chat or shared in a screenshot, treat them as public: change the SA password, generate a
# new JWT_SECRET (which signs out every admin, as it should) and change the Main Admin
# password. Rotating them is the only fix; deleting the commit is not, because the value is
# still in the repository's history and in every clone.
# =========================================================================================

# The address browsers use to reach the site. Vite inlines this into the JS bundle, so
# changing it requires rebuilding the frontend image, not just restarting it:
#     docker compose build frontend && docker compose up -d
# Leaving it on http:// while the site is served over https:// makes the browser block
# every API call, and the page renders with headings but no data - which looks exactly
# like the backend being down.
#
# The same applies to the HOSTNAME, not just the scheme. The Content-Security-Policy that
# nginx sends says `connect-src 'self'`, which means "the exact origin this page came from".
# If visitors can reach the site on an address PUBLIC_ORIGIN does not name — www vs apex, the
# bare IP as well as the domain — then on that address every API call is blocked by the
# browser and the page renders with headings and no data. Pick one canonical origin, put it
# here, and redirect the others to it at the edge.
PUBLIC_ORIGIN=http://YOUR_SERVER_IP

# SQL Server "sa" password. Must be 8+ characters with upper, lower and digits.
# Generate, never invent: openssl rand -base64 24 | tr -d '/+=' | head -c 24
#
# sa is the instance superuser. It is used by scripts/backup-db.sh and by
# scripts/create-db-user.sh — and, until you run that script, by the application itself.
SA_PASSWORD=

# The login the APPLICATION uses. Leave both blank and it falls back to sa, which is how
# an existing deployment keeps working — but sa can read and drop every database on the
# instance, add logins and enable features that run operating-system commands, none of
# which this application needs. A leaked connection string should cost one database.
#
# Create the login and get these two values:
#     ./scripts/create-db-user.sh
DB_USER=
DB_PASSWORD=

# Signing key for JWT access tokens. Anyone holding this can mint a valid admin token.
# Generate: openssl rand -base64 48
JWT_SECRET=

# The first admin account, created on first startup if no Main Admin exists yet.
# The password must satisfy Identity's rules: 8+ chars, at least one uppercase, one
# lowercase and one digit.
#
# Leaving these blank makes AuthSeeder throw, and it runs before the RealEstate seeder,
# so the backend crash-loops with no data seeded at all.
MAIN_ADMIN_EMAIL=
MAIN_ADMIN_PASSWORD=
MAIN_ADMIN_NAME=Main Admin

# =========================================================================================
# SEEDING
#
# There is no SEED_DATA variable any more, and you can delete the line from an existing
# .env. It used to do two unrelated jobs at once: create the Main Admin (without which
# nobody can log in at all, so a first deploy HAD to turn it on) and insert 49 invented
# listings with invented consultants and invented phone numbers. Leaving it on is what put
# the demo listings back every time the container restarted.
#
# Now:
#   * The bootstrap — roles, the Main Admin, the default positions, the property types and
#     the feature catalog — runs automatically on every start and is recorded in a
#     SeedHistory table, so each batch runs exactly ONCE. Whatever you delete stays deleted.
#     Controlled by Startup__SeedIdentity / Startup__SeedReferenceData in docker-compose.yml,
#     both on, both safe to leave on.
#
#     It is skipped entirely when Startup__ApplyMigrations is false, because its first read is
#     the SeedHistory table that those migrations create. A deployment that migrates out of
#     band therefore seeds out of band too:
#         docker compose run --rm backend seed --identity --reference
#
#   * The demo content is an explicit command that a person runs on purpose, and it refuses
#     to run when ASPNETCORE_ENVIRONMENT is Production:
#         docker compose run --rm backend seed --demo
#     Add --force to insert it a second time after deleting it.

# LEGACY - the maps now run on MapLibre GL + OpenFreeMap + Photon (free, no account,
# no token needed). This variable is kept only because docker-compose still passes it
# as a build arg; leave it empty.
VITE_MAPBOX_TOKEN=

# =========================================================================================
# TLS / the Caddy edge
#
# Caddy is the only container published to the internet. These two variables pick which of
# three modes it runs in. docker-compose.yml defaults them to :443 + internal if they are
# absent, so leaving them unset is NOT the same as not running Caddy.
# =========================================================================================

# ---- Mode A: no domain yet, keep the site working on plain HTTP -------------------------
# Let's Encrypt cannot issue a certificate for a bare IP, so there is no way to get a
# trusted certificate for http://169.58.92.138 - a domain is the only route to one.
# Until then the least-bad option is usually to skip TLS entirely:
#   - comment out the whole `caddy:` service in docker-compose.yml
#   - give `frontend:` back its  ports: ["80:80"]
# The site stays reachable exactly as it is today, with no browser warning.

# ---- Mode B: no domain, HTTPS anyway (self-signed) --------------------------------------
# Caddy issues its own certificate from a local CA. Two consequences, both visible to
# every visitor:
#   - the browser shows a full-page "Not secure / certificate authority invalid" warning
#   - port 80 stops answering, because a site address of :443 has no hostname to redirect
#     from - so http://169.58.92.138 fails outright instead of loading
# Useful for testing the TLS path, not for launch.
SITE_ADDRESS=:443
CADDY_TLS=internal

# ---- Mode C: a real domain, a real certificate ------------------------------------------
# Point an A record at the server first and let DNS propagate, then:
#   SITE_ADDRESS=qre.example.com
#   CADDY_TLS=you@example.com          # an email switches Caddy to Let's Encrypt
#   PUBLIC_ORIGIN=https://qre.example.com
# and rebuild the frontend, because PUBLIC_ORIGIN is baked into the bundle:
#   docker compose build frontend && docker compose up -d
#
# Rehearse first. Let's Encrypt allows only about five failed validations per hostname per
# hour; uncomment the staging `acme_ca` line in docker/caddy/Caddyfile, confirm issuance
# works end to end, then comment it back out and restart Caddy for the real certificate.
#
# Startup__UseHttpsRedirection stays "false" in docker-compose.yml either way. Caddy
# already redirects at the edge, and Program.cs never calls UseForwardedHeaders(), so
# Kestrel would only see the plaintext Caddy->nginx hop and redirect forever.


# =========================================================================================
# HSTS (only meaningful when Caddy is enabled and serving a REAL certificate)
#
#   max-age=0                              off, and clears a policy a browser already saw
#   max-age=300                            a 5-minute rehearsal
#   max-age=31536000; includeSubDomains    live
#
# Read the warning in docker/caddy/Caddyfile first. HSTS pins this host to HTTPS in every
# visitor's browser for as long as max-age says; turning it on while Caddy is still using
# its internal (untrusted) CA locks people out, and lowering it afterwards does not reach
# the browsers that already cached it.
# =========================================================================================
CADDY_HSTS=max-age=0
